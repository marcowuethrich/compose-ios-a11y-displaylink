// Signing and bundle id. Put your own values in Local.xcconfig (git-ignored), e.g.
//   TEAM_ID = ABCDE12345
//   BUNDLE_ID_PREFIX = com.yourname
// scripts/build.sh writes that file from the TEAM_ID and BUNDLE_ID_PREFIX environment variables.
TEAM_ID =
BUNDLE_ID_PREFIX = com.example
#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(TEAM_ID)
CODE_SIGN_STYLE = Automatic
REPRO_APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).CmpA11yRepro
